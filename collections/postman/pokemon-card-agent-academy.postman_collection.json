        "body": {
          "mode": "raw",
          "raw": "{\n  \"cardId\": \"MEWTWO_PROMO\",\n  \"userId\": \"user-08\",\n  \"score\": 4,\n  \"tags\": [\"PSYCHIC\", \"PROMO\"],\n  \"experience\": \"Clean promo card with strong binder appeal.\"\n}"
        }
      }
    },
    {
